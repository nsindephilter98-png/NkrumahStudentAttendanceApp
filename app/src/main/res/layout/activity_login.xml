<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp">

        <!-- ================================= -->
        <!-- UNIVERSITY BRAND                  -->
        <!-- ================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Logo -->

            <TextView
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="#123B63"
                android:gravity="center"
                android:text="N"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NKRUMAH"
                    android:textColor="#123B63"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="STUDENT ATTENDANCE SYSTEM"
                    android:textColor="#72808C"
                    android:textSize="10sp"
                    android:letterSpacing="0.06" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================================= -->
        <!-- WELCOME                            -->
        <!-- ================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:text="Welcome back"
            android:textColor="#17212B"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sign in to view and manage your attendance."
            android:textColor="#718096"
            android:textSize="14sp" />

        <!-- ================================= -->
        <!-- LOGIN CARD                         -->
        <!-- ================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="23dp">

            <!-- Student Number -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Number"
                android:textColor="#263746"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etStudentNumber"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:background="#F1F4F7"
                android:hint="e.g. 202312345"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#17212B"
                android:textColorHint="#9AA6B2"
                android:textSize="15sp" />

            <!-- Password -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="Password"
                android:textColor="#263746"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:background="#F1F4F7"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Enter your password"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="#17212B"
                    android:textColorHint="#9AA6B2"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvShowPassword"
                    android:layout_width="60dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="SHOW"
                    android:textColor="#123B63"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Sign In -->

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="27dp"
                android:backgroundTint="#123B63"
                android:text="SIGN IN"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Loading -->

            <ProgressBar
                android:id="@+id/loginProgress"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ================================= -->
        <!-- SECURITY MESSAGE                   -->
        <!-- ================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="🔒  Your student information is kept secure."
            android:textColor="#7B8794"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Nkrumah Student Attendance System"
            android:textColor="#A0AAB4"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>